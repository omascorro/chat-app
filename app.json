{
  "expo": {
    "name": "Aeterna",
    "slug": "chat-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chatapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.mascorro55.chatapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Permite desbloquear la app con Face ID para proteger tus mensajes.",
        "NSCameraUsageDescription": "Permite tomar fotos y videos para enviarlos cifrados.",
        "NSPhotoLibraryUsageDescription": "Permite elegir fotos y videos para enviarlos cifrados."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4B5320",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.mascorro55.chatapp",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4B5320",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4B5320"
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Permite grabar notas de voz para enviarlas a tus contactos."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite desbloquear la app con Face ID para proteger tus mensajes."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          { "name": "Clasico", "ios": "./assets/icons/Clasico-ios.png", "android": { "foregroundImage": "./assets/icons/Clasico-android.png", "backgroundColor": "#128C7E" } },
          { "name": "Oceano", "ios": "./assets/icons/Oceano-ios.png", "android": { "foregroundImage": "./assets/icons/Oceano-android.png", "backgroundColor": "#1F5F7A" } },
          { "name": "Grafito", "ios": "./assets/icons/Grafito-ios.png", "android": { "foregroundImage": "./assets/icons/Grafito-android.png", "backgroundColor": "#26262C" } },
          { "name": "Rosa", "ios": "./assets/icons/Rosa-ios.png", "android": { "foregroundImage": "./assets/icons/Rosa-android.png", "backgroundColor": "#9C3D60" } },
          { "name": "Notas", "ios": "./assets/icons/Notas-ios.png", "android": { "foregroundImage": "./assets/icons/Notas-android.png", "backgroundColor": "#FFC107" } },
          { "name": "Clima", "ios": "./assets/icons/Clima-ios.png", "android": { "foregroundImage": "./assets/icons/Clima-android.png", "backgroundColor": "#1E88E5" } },
          { "name": "Calculadora", "ios": "./assets/icons/Calculadora-ios.png", "android": { "foregroundImage": "./assets/icons/Calculadora-android.png", "backgroundColor": "#1C1C1E" } }
        ]
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir fotos y videos para enviarlos cifrados.",
          "cameraPermission": "Permite tomar fotos y videos para enviarlos cifrados.",
          "microphonePermission": "Permite grabar el audio de los videos que tomas."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c781593f-3886-490c-9ace-885f6acab1db",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c781593f-3886-490c-9ace-885f6acab1db"
      }
    }
  }
}
